{
    "source": {
        "include": [
            "src",
            "../../packages/kalendar/src"
        ],
        "exclude": ["node_modules", "dist"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "uriroot\\.js$"
    },
    "plugins": ["plugins/markdown"],
    "opts": {
        "destination": "./docs",
        "recurse": true
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false
    }
}